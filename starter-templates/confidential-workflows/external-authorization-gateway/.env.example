# Authentication token shared between the local reference gateway
# and the confidential CRE workflow.
SECRET_API_TOKEN=replace-with-local-test-token

# Local reference gateway configuration.
X402_GATEWAY_ADDR=127.0.0.1:8402
X402_GATEWAY_TOKEN=replace-with-local-test-token

# Optional trusted authorization signer.
#
# Leave unset unless the signer has been independently established.
# Do not substitute a claimant-controlled signer.
# X402_AUTH_TRUSTED_SIGNER=0x0000000000000000000000000000000000000000
