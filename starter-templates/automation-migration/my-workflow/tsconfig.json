{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@chainlink/cre-sdk": ["./node_modules/@chainlink/cre-sdk"],
      "@chainlink/cre-sdk/*": ["./node_modules/@chainlink/cre-sdk/*"]
    }
  },
  "include": ["main.ts"]
}
