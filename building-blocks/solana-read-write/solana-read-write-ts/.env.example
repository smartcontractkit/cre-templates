# MAKE A COPY OF THIS FILE AND NAME IT .env
# NEVER commit your actual .env file to the repository.

# Solana 64-byte base58 keypair used by `cre workflow simulate` to sign and submit
# the write transaction. This does NOT need to be a DON key — Chainlink's keystone
# forwarder is what verifies the report; this key just needs devnet SOL for fees.
# Generate one with: solana-keygen new --outfile ./devnet-keypair.json
# then base58-encode its secret key, or reuse ~/.config/solana/id.json.
CRE_SOLANA_PRIVATE_KEY=1111111111111111111111111111111PPm2a2NNZH2EFJ5UkEjkH9Fcxn8cvjTmZDKQQisyLDmA
